@* Router. Falls back to a friendly "not found" page when no route matches. *@

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                <MudPaper Class="pa-6 ma-6">
                    <MudText Typo="Typo.h5">You don't have access to this page.</MudText>
                    <MudText Typo="Typo.body2">
                        Sign in with an account that has access, or ask a workspace admin for an invitation.
                    </MudText>
                </MudPaper>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <MudPaper Class="pa-6 ma-6">
                <MudText Typo="Typo.h4">Page not found</MudText>
                <MudText Typo="Typo.body1">The page you're looking for doesn't exist.</MudText>
            </MudPaper>
        </LayoutView>
    </NotFound>
</Router>
