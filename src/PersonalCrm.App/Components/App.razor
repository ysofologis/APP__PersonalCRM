@* Root component of the Blazor Web App. Hosts the document shell and the
   interactive render mode chosen for each route. *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1976d2" />
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="service-worker.js" type="module"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@inject PersonalCrm.App.Services.ApiClient Api
@inject IJSRuntime Js

@code {
    private bool _hydrated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hydrated)
        {
            try
            {
                var userIdText = await Js.InvokeAsync<string?>("sessionStorage.getItem", "pcrm.userId");
                var wsIdText   = await Js.InvokeAsync<string?>("sessionStorage.getItem", "pcrm.workspaceId");
                var token      = await Js.InvokeAsync<string?>("sessionStorage.getItem", "pcrm.accessToken");

                if (Guid.TryParse(userIdText, out var userId))
                {
                    Api.UserId      = userId;
                    Api.AccessToken = token;
                }
                if (Guid.TryParse(wsIdText, out var wsId))
                {
                    Api.WorkspaceId = wsId;
                }
                _hydrated = true;
            }
            catch
            {
                // sessionStorage not available (e.g. SSR disabled) — ignore.
            }
        }
    }
}

