{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=./data/personal-crm.db"
  },
  "AttachmentStore": {
    "Provider": "local",
    "Local": {
      "Root": "./data/attachments"
    },
    "S3": {
      "Endpoint": "",
      "Bucket": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "Auth": {
    "JwtSigningKey": "REPLACE_ME_WITH_AT_LEAST_64_HEX_CHARS",
    "JwtIssuer": "http://localhost:8080",
    "JwtAudience": "personal-crm",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Personal CRM",
    "UseStartTls": true
  },
  "Vapid": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@example.com"
  },
  "Otel": {
    "ServiceName": "personal-crm",
    "OtlpEndpoint": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  }
}
