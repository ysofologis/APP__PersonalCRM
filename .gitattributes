# Auto-detect text files and normalize line endings to LF on commit.
* text=auto eol=lf

# Explicit text types
*.cs     text eol=lf
*.csproj text eol=lf
*.sln    text eol=lf
*.props  text eol=lf
*.targets text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.webmanifest text eol=lf

# Shell scripts
*.sh     text eol=lf
*.fish   text eol=lf

# Docker / configs
Dockerfile       text eol=lf
.dockerignore    text eol=lf
.editorconfig    text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
LICENSE          text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.db   binary
*.db-* binary
